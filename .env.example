# Browser-safe (exposed to the browser by Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only (Vercel env vars). Prefer the anon key + RPCs; add this only if a route truly needs it.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Edge Function secrets are set with `supabase secrets set`, not here:
# CRON_SECRET, AZ511_KEY, ANTHROPIC_API_KEY, NWS_USER_AGENT
